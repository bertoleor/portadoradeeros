#!/usr/bin/env sh
# Robust pre-commit hook: gitleaks + lint-staged
# Follows the pattern from khal and santisima-trinidad as per decision.
# NO fixed timeout caps (removed 2026-10-18, kanban t_2535124d): timeout 60 killed
# lint-staged under host load (boot ~2m18s) → exit 124 → masivo bypass --no-verify.
# Ctrl+C es el timeout humano; los errores reales siguen bloqueando (fail-closed).

if command -v gitleaks >/dev/null 2>&1; then
  if [ -f .gitleaks.toml ]; then
    gitleaks protect --staged --redact --no-banner --config .gitleaks.toml < /dev/null
  else
    gitleaks protect --staged --redact --no-banner < /dev/null
  fi
  exit_code=$?
  if [ $exit_code -eq 0 ]; then
    echo "gitleaks: no leaks found"
  else
    echo "gitleaks falló (exit $exit_code) — leak real o crash del binario (caps de timeout removidos, ver kanban t_2535124d)" >&2
    exit $exit_code
  fi
else
  echo "gitleaks no instalado — skip local (cubierto por CI)" >&2
  echo "Instalá gitleaks: scoop install gitleaks" >&2
fi

. "$(dirname -- "$0")/_/husky.sh"

# lint-staged: solo archivos staged; --no-stash evita el cuelgue histórico del stash.
if [ -x node_modules/.bin/lint-staged ]; then
  node_modules/.bin/lint-staged --no-stash < /dev/null
  exit_code=$?
  if [ $exit_code -ne 0 ]; then
    echo "lint-staged falló" >&2
    exit $exit_code
  fi
else
  echo "lint-staged no instalado en node_modules — corré pnpm install." >&2
  exit 1
fi

sh "$(dirname -- "$0")/gga.sh"
gga_code=$?
if [ $gga_code -ne 0 ]; then
  echo "❌ Pre-commit: gga falló (exit $gga_code). exit 1 = secreto detectado (revisar arriba). exit 127/53/otro = probable muerte de forks MSYS (0xC0000142, host saturado) — reintentá; NO es un bypass válido." >&2
  exit $gga_code
fi

echo "✅ Pre-commit: lint-staged + gga passed"