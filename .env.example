# EROS — variables de entorno (solo NOMBRES, sin valores)
# Copiar a .env.local y completar. Nunca commitear .env* (ignorado por .gitignore).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=

# Email — proveedor y remitente
EMAIL_PROVIDER=
EMAIL_FROM=

# Email — Resend
RESEND_API_KEY=

# Email — SMTP (nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Email — EmailJS (@emailjs/nodejs)
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_CONFIRMADO=
EMAILJS_TEMPLATE_PENDIENTE=

# Push notifications (web-push / VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cron (vercel.json → /api/cron/reminders)
CRON_SECRET=
