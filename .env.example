# EROS — variables de entorno (solo NOMBRES, sin valores)
# Copiar a .env.local y completar. Nunca commitear .env* (ignorado por .gitignore).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=

# Email — proveedor y remitente
EMAIL_PROVIDER=
EMAIL_FROM=

# Email — Resend
RESEND_API_KEY=

# Email — SMTP fallback (nodemailer, activo solo con EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Push notifications (web-push / VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cron (vercel.json → /api/cron/reminders)
CRON_SECRET=

# WhatsApp — link público del negocio (default en src/lib/socials.ts)
NEXT_PUBLIC_WHATSAPP_URL=
# WhatsApp — soporte del dashboard admin (default en src/lib/socials.ts)
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=
