# Supabase Configuration
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECURITY (Slice 1 — auditoría)
# - Public signup is DISABLED in the Supabase dashboard (Authentication →
#   Providers → Email → "Enable new signups" → OFF). No env var controls this.
# - Admin authorization is NOT env-based: the allowlist lives in the
#   `public.admin_users` table (seeded UID) via the `is_admin()` SQL function.
# - SUPABASE_SERVICE_ROLE_KEY is server-only and MUST NOT be exposed to the
#   browser (no NEXT_PUBLIC_ prefix). It is scoped to push subscription reads.

# Resend (Email Service)
# Get your API key from https://resend.com
RESEND_API_KEY=re_123456789

# Google Calendar (sync de turnos confirmados → calendario de la admin)
# Setup paso a paso: docs/google-calendar-setup.md
# - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: credenciales OAuth2 de Google Cloud Console
# - GOOGLE_REFRESH_TOKEN: token offline obtenido una vez vía OAuth playground (ver doc)
# - GOOGLE_CALENDAR_ID: 'primary' u el email del calendario a usar
# - GOOGLE_CALENDAR_TIMEZONE: zona horaria de los eventos (default America/Argentina/Buenos_Aires)
# Sin GOOGLE_REFRESH_TOKEN la app funciona igual (emails + panel admin),
# simplemente no sincroniza con Google (best-effort, loguea el fallo).
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Argentina/Buenos_Aires
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron (Recordatorios de turnos) — GET /api/cron/reminders
# Shared secret guarding the reminders endpoint (fails closed when unset).
# Vercel Cron sends this as the `Authorization: Bearer <CRON_SECRET>` header on
# every scheduled run. Set the same value in Vercel → Settings → Environment
# Variables and in vercel.json `crons` (the `path` matches the header value).
# Generate with: openssl rand -base64 32
CRON_SECRET=generate-a-long-random-secret
